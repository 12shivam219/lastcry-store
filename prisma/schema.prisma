// LastCry — Comprehensive PostgreSQL & Prisma Schema (Section 17)
// Supports decimal-safe money (in INR / Paise & Decimal), RBAC, soft deletion/archival,
// separate payment & fulfilment statuses, and regional/tradition review workflows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  CUSTOMER
  ADMIN
  OPERATIONS_MANAGER
  CONTENT_REVIEWER
  FINANCE_AUDITOR
}

enum ReviewStatus {
  DRAFT
  PENDING_CULTURAL_REVIEW
  REVIEWED_VERIFIED
  ARCHIVED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum ItemDesignation {
  ESSENTIAL
  OPTIONAL
  REGION_DEPENDENT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  PROCESSING
  READY_FOR_DISPATCH
  SHIPPED
  DELIVERED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfilmentStatus {
  UNFULFILLED
  RESERVED
  PREPARING
  READY_FOR_DISPATCH
  IN_TRANSIT
  DELIVERED
  CANCELLED
  RETURNED
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  phone               String?         @unique
  fullName            String
  passwordHash        String?
  roleId              String
  role                Role            @relation(fields: [roleId], references: [id])
  deletionRequestedAt DateTime?
  archivedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  addresses           Address[]
  carts               Cart[]
  wishlistItems       WishlistItem[]
  orders              Order[]
  reviews             ProductReview[]
  supportTickets      SupportTicket[]
  consentRecords      ConsentRecord[]
  auditLogs           AuditLog[]

  @@index([email])
}

model Role {
  id          String   @id @default(cuid())
  name        RoleType @unique
  permissions String[]
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Address {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String    @default("Home")
  recipient    String
  phone        String
  line1        String
  line2        String?
  city         String
  state        String
  pinCode      String
  countryCode  String    @default("IN")
  isDefault    Boolean   @default(false)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, pinCode])
}

model Category {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  description       String
  seoTitle          String?
  seoDescription    String?
  publicationStatus PublicationStatus @default(PUBLISHED)
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  products          Product[]
}

model TraditionTag {
  id                  String       @id @default(cuid())
  name                String
  slug                String       @unique
  description         String
  regionalNote        String
  reviewerName        String?
  reviewStatus        ReviewStatus @default(REVIEWED_VERIFIED)
  lastReviewedAt      DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  products            Product[]
  ritualKits          RitualKit[]
}

model Supplier {
  id                 String            @id @default(cuid())
  name               String
  code               String            @unique
  legalBusinessName  String
  gstin              String?
  contactPerson      String
  email              String
  phone              String
  city               String
  state              String
  fulfilmentRegions  String[]
  verificationStatus String            @default("PENDING_VERIFICATION")
  dispatchSlaHours   Int               @default(24)
  onTimeRatePercent  Decimal?          @db.Decimal(5, 2)
  operationalNotes   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  products           Product[]
  supplierProducts   SupplierProduct[]
  shipments          Shipment[]
}

model Product {
  id                  String            @id @default(cuid())
  name                String
  slug                String            @unique
  sku                 String            @unique
  shortDescription    String
  fullDescription     String
  categoryId          String
  category            Category          @relation(fields: [categoryId], references: [id])
  supplierId          String
  supplier            Supplier          @relation(fields: [supplierId], references: [id])
  currencyCode        String            @default("INR")
  sellingPriceInr     Decimal           @db.Decimal(12, 2)
  mrpInr              Decimal           @db.Decimal(12, 2)
  costPriceInr        Decimal           @db.Decimal(12, 2)
  gstPercent          Decimal           @default(5.00) @db.Decimal(5, 2)
  hsnCode             String?
  weightGrams         Int               @default(500)
  dimensionsCm        String            @default("25 x 20 x 8 cm")
  materials           String?
  specifications      Json?
  traditionNotes      String?
  designation         ItemDesignation   @default(ESSENTIAL)
  estimatedDispatch   String            @default("Dispatches within 12–24 hours")
  returnEligibility   String            @default("Returnable within 7 days if unopened and seal intact")
  complianceVerified  Boolean           @default(true)
  isSampleData        Boolean           @default(true)
  reviewStatus        ReviewStatus      @default(REVIEWED_VERIFIED)
  reviewedBy          String?
  publicationStatus   PublicationStatus @default(PUBLISHED)
  seoTitle            String?
  seoDescription      String?
  archivedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  traditionTags       TraditionTag[]
  variants            ProductVariant[]
  images              ProductImage[]
  inventory           Inventory?
  supplierProducts    SupplierProduct[]
  kitItems            RitualKitItem[]
  reviews             ProductReview[]
  cartItems           CartItem[]
  wishlistItems       WishlistItem[]
  orderItems          OrderItem[]

  @@index([categoryId, publicationStatus])
  @@index([slug])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  sku             String   @unique
  sellingPriceInr Decimal  @db.Decimal(12, 2)
  mrpInr          Decimal  @db.Decimal(12, 2)
  stockQuantity   Int      @default(0)
  attributes      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProductImage {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url           String
  altText       String
  isPlaceholder Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
}

model Inventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockQuantity     Int      @default(0)
  reservedQuantity  Int      @default(0)
  lowStockThreshold Int      @default(5)
  warehouseLocation String   @default("Mumbai Central Hub")
  updatedAt         DateTime @updatedAt
}

model SupplierProduct {
  id              String   @id @default(cuid())
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierSku     String
  leadTimeHours   Int      @default(12)
  supplyPriceInr  Decimal  @db.Decimal(12, 2)
  updatedAt       DateTime @updatedAt

  @@unique([supplierId, productId])
}

model RitualKit {
  id                  String            @id @default(cuid())
  name                String
  slug                String            @unique
  sku                 String            @unique
  shortDescription    String
  fullDescription     String
  intendedTradition   String
  regionalScope       String
  traditionTagId      String?
  traditionTag        TraditionTag?     @relation(fields: [traditionTagId], references: [id])
  currencyCode        String            @default("INR")
  basePriceInr        Decimal           @db.Decimal(12, 2)
  mrpInr              Decimal           @db.Decimal(12, 2)
  gstPercent          Decimal           @default(5.00) @db.Decimal(5, 2)
  imageUrl            String
  imageAlt            String
  estimatedDispatch   String            @default("Prepared & dispatched within 6–12 hours in supported zones")
  reviewStatus        ReviewStatus      @default(REVIEWED_VERIFIED)
  reviewedBy          String
  lastReviewedAt      DateTime
  publicationStatus   PublicationStatus @default(PUBLISHED)
  versionNumber       Int               @default(1)
  versionNotes        String
  isSampleData        Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  items               RitualKitItem[]
}

model RitualKitItem {
  id              String          @id @default(cuid())
  kitId           String
  kit             RitualKit       @relation(fields: [kitId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  quantity        Int             @default(1)
  designation     ItemDesignation @default(ESSENTIAL)
  intendedUseNote String
  additionalPrice Decimal         @default(0.00) @db.Decimal(12, 2)
  sortOrder       Int             @default(0)

  @@unique([kitId, productId])
}

model ProductReview {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  orderId            String
  rating             Int
  comment            String
  verifiedPurchase   Boolean      @default(true)
  moderationStatus   ReviewStatus @default(PENDING_CULTURAL_REVIEW)
  createdAt          DateTime     @default(now())
}

model Cart {
  id           String     @id @default(cuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionToken String     @unique
  pinCode      String?
  couponCode   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        CartItem[]
}

model CartItem {
  id                 String   @id @default(cuid())
  cartId             String
  cart               Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id])
  ritualKitId        String?
  variantId          String?
  quantity           Int      @default(1)
  selectedOptionIds  String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id                String   @id @default(cuid())
  code              String   @unique
  description       String
  discountType      String   @default("FLAT_INR") // FLAT_INR or PERCENTAGE
  discountValue     Decimal  @db.Decimal(12, 2)
  minOrderInr       Decimal  @default(0.00) @db.Decimal(12, 2)
  maxDiscountInr    Decimal? @db.Decimal(12, 2)
  isActive          Boolean  @default(true)
  expiresAt         DateTime?
  usageLimit        Int?
  usedCount         Int      @default(0)
  createdAt         DateTime @default(now())
}

model DeliveryZone {
  id                      String   @id @default(cuid())
  zoneName                String
  city                    String
  state                   String
  pinCodePrefixes         String[]
  supportedDeliveryModes  String[]
  standardFeeInr          Decimal  @db.Decimal(12, 2)
  freeDeliveryThreshold   Decimal  @db.Decimal(12, 2)
  dispatchCutoffLocalTime String   @default("16:00 IST")
  estimatedWindow         String   @default("1–2 business days (Standard Surface/Air)")
  priorityWindow          String?
  priorityFeeInr          Decimal? @db.Decimal(12, 2)
  restrictedCategories    String[]
  isActive                Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

model Order {
  id                   String           @id @default(cuid())
  orderNumber          String           @unique
  userId               String?
  user                 User?            @relation(fields: [userId], references: [id])
  customerName         String
  customerEmail        String
  customerPhone        String
  shippingLine1        String
  shippingLine2        String?
  shippingCity         String
  shippingState        String
  shippingPinCode      String
  deliveryInstructions String?
  deliveryMethod       String
  currencyCode         String           @default("INR")
  subtotalInr          Decimal          @db.Decimal(12, 2)
  taxInr               Decimal          @db.Decimal(12, 2)
  deliveryFeeInr       Decimal          @db.Decimal(12, 2)
  discountInr          Decimal          @default(0.00) @db.Decimal(12, 2)
  totalInr             Decimal          @db.Decimal(12, 2)
  couponCode           String?
  orderStatus          OrderStatus      @default(PENDING_PAYMENT)
  paymentStatus        PaymentStatus    @default(PENDING)
  fulfilmentStatus     FulfilmentStatus @default(UNFULFILLED)
  internalNotes        String?
  isSampleData         Boolean          @default(false)
  archivedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  items                OrderItem[]
  payments             Payment[]
  refunds              Refund[]
  shipments            Shipment[]

  @@index([orderNumber])
  @@index([customerEmail])
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id])
  itemType         String   @default("PRODUCT") // PRODUCT or RITUAL_KIT
  title            String
  sku              String
  variantLabel     String?
  quantity         Int
  unitPriceInr     Decimal  @db.Decimal(12, 2)
  gstPercent       Decimal  @db.Decimal(5, 2)
  lineTotalInr     Decimal  @db.Decimal(12, 2)
  kitContentsSummary String?
}

model Payment {
  id                  String        @id @default(cuid())
  orderId             String
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider            String        @default("RAZORPAY_SANDBOX")
  providerOrderId     String        @unique
  providerPaymentId   String?       @unique
  idempotencyKey      String        @unique
  amountInr           Decimal       @db.Decimal(12, 2)
  currencyCode        String        @default("INR")
  status              PaymentStatus @default(PENDING)
  signatureVerified   Boolean       @default(false)
  isSandbox           Boolean       @default(true)
  failureReason       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Refund {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId        String
  amountInr        Decimal  @db.Decimal(12, 2)
  reason           String
  status           String   @default("PENDING_APPROVAL")
  approvedByUserId String?
  processedAt      DateTime?
  createdAt        DateTime @default(now())
}

model Shipment {
  id                String           @id @default(cuid())
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId        String?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  carrierName       String
  trackingNumber    String?
  status            FulfilmentStatus @default(PREPARING)
  dispatchedAt      DateTime?
  deliveredAt       DateTime?
  estimatedDelivery String?
  updatedAt         DateTime         @updatedAt
}

model ServiceProvider {
  id                 String           @id @default(cuid())
  name               String
  slug               String           @unique
  category           String
  city               String
  state              String
  serviceAreas       String[]
  publicPhone        String
  publicEmail        String
  verificationStatus String           @default("DEMO_UNVERIFIED")
  verifiedBy         String?
  verifiedAt         DateTime?
  isSampleData       Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  listings           ServiceListing[]
  enquiries          ServiceEnquiry[]
}

model ServiceListing {
  id                String          @id @default(cuid())
  providerId        String
  provider          ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title             String
  slug              String          @unique
  category          String
  summary           String
  description       String
  publishedPricing  String          @default("Provided upon enquiry based on scope and location")
  availabilityNote  String          @default("Enquiry-based referral — live instant booking not enabled")
  bookingMode       String          @default("ENQUIRY_ONLY")
  isSampleData      Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ServiceEnquiry {
  id               String          @id @default(cuid())
  providerId       String
  provider         ServiceProvider @relation(fields: [providerId], references: [id])
  customerName     String
  customerPhone    String
  customerEmail    String
  city             String
  pinCode          String
  message          String
  status           String          @default("RECEIVED")
  createdAt        DateTime        @default(now())
}

model ContentArticle {
  id                  String            @id @default(cuid())
  title               String
  slug                String            @unique
  summary             String
  bodyMarkdown        String
  applicableTradition String            @default("General / All Traditions")
  applicableRegion    String            @default("Pan-India")
  reviewerName        String
  reviewerCredentials String
  reviewStatus        ReviewStatus      @default(REVIEWED_VERIFIED)
  lastReviewedAt      DateTime
  sources             String[]
  disclaimer          String
  relatedProductSlugs String[]
  publicationStatus   PublicationStatus @default(PUBLISHED)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model SupportTicket {
  id            String   @id @default(cuid())
  ticketNumber  String   @unique
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  name          String
  email         String
  phone         String?
  orderNumber   String?
  category      String   @default("ORDER_SUPPORT")
  subject       String
  message       String
  status        String   @default("OPEN")
  resolution    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ConsentRecord {
  id                        String   @id @default(cuid())
  userId                    String
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderUpdatesEmail         Boolean  @default(true)
  orderUpdatesSms           Boolean  @default(true)
  guidanceNewsletterOptIn   Boolean  @default(false)
  bereavementPrivacyAck     Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  actorEmail  String
  actorRole   String
  action      String
  entityType  String
  entityId    String
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
