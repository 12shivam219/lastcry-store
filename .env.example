# GEMINI_API_KEY: Required for Gemini AI API calls if server-side assistance is enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / NEXT_PUBLIC_APP_URL: Canonical base URL for SEO, sitemaps, and webhooks.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string for Prisma ORM in production.
# In local development without PostgreSQL configured, LastCry uses its transactional file-backed store (.data/lastcry-db.json).
DATABASE_URL="postgresql://lastcry_user:password@localhost:5432/lastcry?schema=public"

# SESSION_SECRET & ADMIN_BOOTSTRAP_TOKEN: Used for signing HTTP-only session cookies and initial admin bootstrap.
SESSION_SECRET="replace-with-at-least-32-char-cryptographic-secret"
ADMIN_BOOTSTRAP_TOKEN="replace-with-one-time-admin-bootstrap-token"

# RAZORPAY PAYMENT ADAPTER (India):
# Leave empty in local development to use the clearly labelled Sandbox Payment Adapter.
# Never mark orders paid without server-side signature verification.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PAYMENT_SANDBOX_MODE="true"

# TRANSACTIONAL EMAIL (SMTP / Postmark / SES):
# Leave empty in development to log transactional dispatches to server console & audit log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="support@lastcry.in"

